# EasyInviteMaker environment — copy to .env and fill in.
# Placeholder values only; never commit real secrets.
#
# Two kinds of variable live here:
#   PUBLIC  — VITE_* values are baked into the browser bundle at build
#             time. Anything with a VITE_ prefix is visible to every
#             visitor; never put a secret behind one.
#   SERVER SECRET — no VITE_ prefix (except VITE_SUPABASE_URL, which
#             the server also reads). These exist only in the server
#             runtime (Cloudflare secrets in production). They must
#             NEVER reach the browser bundle or a commit.

# ---------------------------------------------------------------------
# Supabase (Supabase → Project Settings → API)
# ---------------------------------------------------------------------

# PUBLIC + server: project URL. The browser client uses it, and the
# server reads it too (process.env) — set it in both places.
VITE_SUPABASE_URL=https://your-project.supabase.co

# PUBLIC: publishable (anon) key. Safe to expose — row-level security
# is what protects the data. Use this one in the browser, never the
# secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER SECRET: service_role key. Bypasses row-level security — the
# webhook settlement and signed-URL code run on it. Server runtime
# only (Cloudflare secret in production); NEVER commit, NEVER expose
# to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------

# PUBLIC: canonical public origin of the deployed site (no trailing
# slash). Used to build absolute SEO URLs (og:url) and share links.
# Leave unset for local development — those tags are simply omitted
# until this is set.
VITE_SITE_URL=https://www.yourdomain.com

# ---------------------------------------------------------------------
# Razorpay payment gateway
# ---------------------------------------------------------------------

# PUBLIC: Razorpay key id — baked into the bundle so Checkout.js can
# open with it client-side. This is the public half of the API key
# pair (Razorpay Dashboard → Settings → API Keys); it is meant to be
# exposed and carries no spending power on its own.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# SERVER SECRET: the matching key secret — Basic Auth (key_id:key_secret)
# for order creation (POST /v1/orders) and the webhook's gateway
# payment lookup (GET /v1/payments/{id}). Server runtime only; NEVER
# commit, NEVER expose to the browser.
RAZORPAY_KEY_SECRET=your_key_secret_here

# SERVER SECRET: a separate value from the key secret above, set when
# the webhook endpoint is configured in the Razorpay Dashboard
# (Settings → Webhooks). Used for HMAC-SHA256 signature verification
# of incoming webhook deliveries. Server runtime only; NEVER commit.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ---------------------------------------------------------------------
# Payment confirmation email (optional — resend.com)
# ---------------------------------------------------------------------

# SERVER SECRET: Resend API key. When unset, the webhook simply skips
# sending the confirmation email (logged, never thrown) — order
# settlement and invite publication are unaffected either way. Server
# runtime only; NEVER commit, NEVER expose to the browser.
RESEND_API_KEY=

# SERVER SECRET: "Display Name <address>" the confirmation email is
# sent from. The domain must be verified as a sending domain in the
# Resend dashboard first, or Resend rejects the send.
EMAIL_FROM=EasyInviteMaker <notifications@easyinvitemaker.com>

# ---------------------------------------------------------------------
# Google Analytics (GA4) — optional
# ---------------------------------------------------------------------

# PUBLIC: GA4 Measurement ID (starts with "G-"). Not a secret — it's
# visible in every page's source and network requests anyway, the same
# way the Razorpay key id above is. When unset, the gtag script is
# simply omitted; no analytics calls are made. Page views only — no
# custom event sends invitation content, names, emails or venue
# details.
VITE_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------
# Google Analytics (GA4) Data API — optional, powers /admin's
# "Visitors" panel. A DIFFERENT credential from the Measurement ID
# above: that one lets the browser SEND pageviews; this one lets the
# server READ aggregated visitor counts back out. Setup:
#   1. In the same Google Cloud project as the OAuth client, enable
#      the "Google Analytics Data API" and create a Service Account.
#   2. Create a JSON key for it and copy its "client_email" and
#      "private_key" fields below.
#   3. In GA4 → Admin → Property Access Management, add that
#      client_email as a Viewer on the EasyInviteMaker property.
#   4. Find the numeric Property ID in GA4 → Admin → Property Settings
#      (NOT the "G-..." Measurement ID — a plain number).
# When any of the three below is unset, /admin shows "not set up yet"
# for visitors — every other panel is unaffected.

# SERVER SECRET: the service account's client_email.
GA4_SERVICE_ACCOUNT_EMAIL=

# SERVER SECRET: the service account's private_key, newlines kept as
# literal \n (the JSON key file already has them that way — paste the
# "private_key" field's value as-is, including the BEGIN/END lines).
GA4_SERVICE_ACCOUNT_KEY=

# SERVER SECRET (not sensitive on its own, but kept alongside the two
# above): the GA4 property's numeric ID, e.g. 123456789.
GA4_PROPERTY_ID=
