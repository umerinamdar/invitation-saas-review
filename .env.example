# EasyInviteMaker environment — copy to .env and fill in.
# Placeholder values only; never commit real secrets.
#
# Two kinds of variable live here:
#   PUBLIC  — VITE_* values are baked into the browser bundle at build
#             time. Anything with a VITE_ prefix is visible to every
#             visitor; never put a secret behind one.
#   SERVER SECRET — no VITE_ prefix (except VITE_SUPABASE_URL, which
#             the server also reads). These exist only in the server
#             runtime (Cloudflare secrets in production). They must
#             NEVER reach the browser bundle or a commit.

# ---------------------------------------------------------------------
# Supabase (Supabase → Project Settings → API)
# ---------------------------------------------------------------------

# PUBLIC + server: project URL. The browser client uses it, and the
# server reads it too (process.env) — set it in both places.
VITE_SUPABASE_URL=https://your-project.supabase.co

# PUBLIC: publishable (anon) key. Safe to expose — row-level security
# is what protects the data. Use this one in the browser, never the
# secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER SECRET: service_role key. Bypasses row-level security — the
# webhook settlement and signed-URL code run on it. Server runtime
# only (Cloudflare secret in production); NEVER commit, NEVER expose
# to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------

# PUBLIC: canonical public origin of the deployed site (no trailing
# slash). Used to build absolute SEO URLs (og:url) and share links.
# Leave unset for local development — those tags are simply omitted
# until this is set.
VITE_SITE_URL=https://www.yourdomain.com

# ---------------------------------------------------------------------
# Razorpay payment gateway
# ---------------------------------------------------------------------

# PUBLIC: Razorpay key id — baked into the bundle so Checkout.js can
# open with it client-side. This is the public half of the API key
# pair (Razorpay Dashboard → Settings → API Keys); it is meant to be
# exposed and carries no spending power on its own.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# SERVER SECRET: the matching key secret — Basic Auth (key_id:key_secret)
# for order creation (POST /v1/orders) and the webhook's gateway
# payment lookup (GET /v1/payments/{id}). Server runtime only; NEVER
# commit, NEVER expose to the browser.
RAZORPAY_KEY_SECRET=your_key_secret_here

# SERVER SECRET: a separate value from the key secret above, set when
# the webhook endpoint is configured in the Razorpay Dashboard
# (Settings → Webhooks). Used for HMAC-SHA256 signature verification
# of incoming webhook deliveries. Server runtime only; NEVER commit.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
